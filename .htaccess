RewriteEngine on

# Canonical host: strip www -> apex (any protocol), force HTTPS.
# 1) www.* -> https://play2wingames.com (single hop, both http + https)
RewriteCond %{HTTP_HOST} ^www\.play2wingames\.com$ [NC]
RewriteRule ^(.*)$ https://play2wingames.com/$1 [R=301,L]

# 2) Force HTTPS on the bare apex (proxy-aware: GoDaddy may terminate
#    SSL upstream and pass X-Forwarded-SSL: on, so check both).
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-SSL} !on
RewriteCond %{HTTP_HOST} ^play2wingames\.com$ [NC]
RewriteRule ^(.*)$ https://play2wingames.com/$1 [R=301,L]

# Server-side redirects for retired page names (the HTML files keep their
# meta-refresh fallback in case the site is previewed without Apache).
RewriteRule ^mods\.html$ /upgrades.html [R=301,L]
RewriteRule ^showcase\.html$ /sell-trade.html#showcase [NE,R=301,L]

# Shop: /shop, /shop/search, /shop/category/<type>, /shop/product/<id>-<slug> all go to the
# shop's PHP router. Real files (shop/shop.css, shop/sync.php, ...) are served as they are.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^shop(?:/.*)?$ /shop/index.php [L,QSA]

# Serve the branded error page for unknown URLs.
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType image/avif .avif
</IfModule>

# Site code and event data must revalidate on every load ("no-cache" still
# allows ETag/304, so unchanged files stay cheap). This prevents old HTML,
# JavaScript, CSS, or events.json from lingering after a deploy, including
# inline pairings code and the external form/navigation scripts.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Permissions-Policy "camera=(self), geolocation=(), microphone=(), payment=(self "https://www.paypal.com" "https://www.sandbox.paypal.com"), usb=()"

  # Observe violations before enforcing a CSP. The current site deliberately
  # uses inline scripts/styles plus Firebase, Formspree, Google Maps, Google
  # Fonts (404 only), on-demand Tesseract workers, and PayPal (shop checkout). Report-only protects the
  # rollout from breaking those integrations while exposing unexpected loads
  # in browser developer tools.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://formspree.io; img-src 'self' data: blob: https://crystalcommerce-assets.cdn.crystalcommerce.com https://*.paypal.com https://*.paypalobjects.com; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://cdn.jsdelivr.net https://*.paypal.com https://*.paypalobjects.com; connect-src 'self' https://formspree.io https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebaseapp.com https://cdn.jsdelivr.net https://tessdata.projectnaptha.com https://*.paypal.com; frame-src https://maps.google.com https://www.google.com https://*.paypal.com; worker-src 'self' blob: https://cdn.jsdelivr.net; child-src blob:; manifest-src 'self'"

  <FilesMatch "\.(?:html|css|js|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
