# Play2Win shop (CrystalCommerce) settings. PLACEHOLDERS ONLY: never put real values in this file.
#
# Real values go in a private .env OUTSIDE the website folder on GoDaddy, next to the
# trade-in calculator's data folder:
#   <home>/p2w-shop-data/.env     (public_html is the website; this sits beside it)
# The shop's PHP reads real environment variables first, then that file. Shared hosting
# has no other private place for secrets: anything inside public_html is deployed from
# this public repo and can be overwritten by the deploy.

# CrystalCommerce Core2 API: where /shop reads inventory today. Not secret; these are the defaults
# built into shop/lib.php, so they only need setting if CrystalCommerce changes them.
CC_CORE2_BASE=https://core2-api.crystalcommerce.com
CC_CORE2_ORG_ID=2020

# Classic CrystalCommerce admin API (not used yet: needed for a cart handoff with CrystalCommerce's own
# item ids, and as a documented fallback inventory source).
# Base URL is your store's admin host + /api/v1, e.g. https://STORENAME-admin.crystalcommerce.com/api/v1
CC_ADMIN_BASE_URL=https://STORENAME-admin.crystalcommerce.com/api/v1

# Sent as X-API-USERNAME (your CrystalCommerce store domain/username).
CC_API_USERNAME=YOUR_STORE_DOMAIN

# Sent as X-API-PROXY-SECRET. From the store admin: Account/Prefs > Integrations > API > "Your Proxy Secret".
CC_API_PROXY_SECRET=replace-with-your-proxy-secret

# Sent as X-API-SCOPES. Read-only inventory is all the storefront needs.
CC_API_SCOPES=admin:read-inventory

# The public CrystalCommerce storefront (where cart/checkout happen).
CC_STOREFRONT_URL=https://playtowingames.crystalcommerce.com

# Shared secret for the scheduled sync job (cron) to call the sync endpoint. Any long random string.
SHOP_SYNC_KEY=replace-with-a-long-random-string
