{
  "manifest_version": 3,
  "name": "Play2Win Market Helper",
  "version": "1.1.6",
  "description": "Checks GameStop stock, finds direct eBay sold listings and verifies sale prices for Play2Win. Never buys, bids, or changes carts.",
  "homepage_url": "https://play2wingames.com/trade-in/helper.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://play2wingames.com/trade-in/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.gamestop.com/*products/*",
        "https://gamestop.com/*products/*"
      ],
      "js": [
        "stock-reader.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ebay.com/itm/*",
        "https://ebay.com/itm/*"
      ],
      "js": [
        "ebay-reader.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ebay.com/sch/i.html*",
        "https://ebay.com/sch/i.html*"
      ],
      "js": [
        "ebay-search-reader.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
