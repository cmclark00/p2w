{
  "manifest_version": 3,
  "name": "Play2Win Market Helper",
  "version": "1.1.1",
  "description": "Checks GameStop stock and verifies eBay sold prices for Play2Win floor pricing. Never buys, bids, or changes carts.",
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://play2wingames.com/trade-in/*"], "js": ["bridge.js"], "run_at": "document_start" },
    { "matches": ["https://www.gamestop.com/*products/*", "https://gamestop.com/*products/*"], "js": ["stock-reader.js"], "run_at": "document_idle" },
    { "matches": ["https://www.ebay.com/itm/*", "https://ebay.com/itm/*"], "js": ["ebay-reader.js"], "run_at": "document_idle" }
  ]
}
